rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in student can read and write only their own data: users/{their uid} and anything under it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // The app stores the whole state in the document users/{uid} itself, so allow that path too.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else stays locked.
  }
}
